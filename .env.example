# ============================================================
# Coding Agent Monitor — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# LLM (Ollama)
# ------------------------------------------------------------
# Base URL of the OpenAI-compatible API endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# API key passed to the endpoint (Ollama ignores it, but the
# openai client requires a non-empty value)
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the FastAPI server
CORS_ORIGINS=http://localhost:3000

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Path to the SQLite database file
DB_PATH=agent_monitor.db

# ------------------------------------------------------------
# Claude log ingestion
# ------------------------------------------------------------
# Root directory where Claude Code writes its JSONL session logs.
# Defaults to ~/.claude/projects if unset.
CLAUDE_LOG_ROOT=~/.claude/projects

# ------------------------------------------------------------
# Alerting (optional)
# ------------------------------------------------------------
# Slack incoming-webhook URL. When set, high-severity flags are
# posted to Slack. Leave blank to disable alerting.
SLACK_WEBHOOK_URL=

# Public base URL of this server, used to build session links in
# Slack alerts (e.g. http://your-host:8000). Leave blank to omit
# the link from alert messages.
BASE_URL=
