# ============================================================
# Coding Agent Monitor — Environment Variables
# Copy this file to .env and fill in your values.
# Keys prefixed NEXT_PUBLIC_ are also needed by the frontend —
# copy them to frontend/.env.local as well.
# ============================================================

# ------------------------------------------------------------
# LLM (OpenAI)
# ------------------------------------------------------------
# OpenAI API key. Required when using the OpenAI provider.
OPENAI_API_KEY=

# ------------------------------------------------------------
# LLM (Ollama)
# ------------------------------------------------------------
# Base URL of the OpenAI-compatible API endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1

# API key passed to the Ollama endpoint. Ollama ignores the value
# but the openai-python client requires a non-empty string.
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Comma-separated list of origins the FastAPI CORS middleware allows.
CORS_ORIGINS=http://localhost:3000

# Log level for the backend: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Optional shared secret to protect all backend endpoints.
# Leave blank to disable authentication entirely.
API_KEY=

# Must match API_KEY above. The NEXT_PUBLIC_ prefix is required for
# Next.js to expose this value to the browser at build time.
NEXT_PUBLIC_API_KEY=

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Path to the SQLite database file (relative to the backend working dir).
DB_PATH=agent_monitor.db

# ------------------------------------------------------------
# Claude log ingestion
# ------------------------------------------------------------
# Root directory where Claude Code writes its JSONL session logs.
# Defaults to ~/.claude/projects if unset.
CLAUDE_LOG_ROOT=~/.claude/projects

# ------------------------------------------------------------
# Alerting (optional)
# ------------------------------------------------------------
# Slack incoming-webhook URL. When set, high-severity flagged steps
# are posted to the channel. Leave blank to disable Slack alerts.
SLACK_WEBHOOK_URL=

# Public base URL of this server, used to build deep-links in Slack
# alert messages (e.g. http://your-host:8000). Leave blank to omit.
BASE_URL=
